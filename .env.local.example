# Copy to .env.local for local dev. In Vercel, add these under
# Project Settings -> Environment Variables (Production + Preview).

# ─── Backend API (Phase 1 — leads) ─────────────────────────────────────────
# SERVER-ONLY. No NEXT_PUBLIC_ prefix, so the browser never sees them.
CYBRIX_API_URL=
CYBRIX_API_TOKEN=

# ─── WhatsApp bot (Phase 2) ────────────────────────────────────────────────

# Token you invent — must match the value you paste into Meta's webhook
# verification screen. Meta sends this back on the initial GET handshake.
# Any long random string works: `openssl rand -hex 24`.
WHATSAPP_VERIFY_TOKEN=

# The Cybrix WhatsApp Business phone number (E.164, no + or spaces).
# PUBLIC — shown on the floating "Chat on WhatsApp" button.
# Example: 923001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Existing admin auth ───────────────────────────────────────────────────
# ADMIN_USERS is a JSON array; overrides ADMIN_PASSWORD when set.
# ADMIN_USERS=[{"username":"talha","password":"pick-something-strong"}]
ADMIN_PASSWORD=
