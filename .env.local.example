# Copy to .env.local for local dev. In Vercel, add these under
# Project Settings -> Environment Variables (Production + Preview).
#
# Both are SERVER-ONLY (no NEXT_PUBLIC_ prefix) so the browser never sees them.

# The Cybrix backend on the VPS. No trailing slash.
# Local dev: http://localhost:8000    Prod: https://api.<your-domain>
CYBRIX_API_URL=

# Shared bearer token that gates admin reads (GET /leads, /leads/stats, PATCH /leads/:id).
# MUST match the CYBRIX_API_TOKEN value in the VPS .env. Generate with:
#   openssl rand -hex 32
CYBRIX_API_TOKEN=

# --- Existing admin auth vars (already used by /api/admin/auth) ---
# ADMIN_USERS is a JSON array; overrides ADMIN_PASSWORD when set.
# ADMIN_USERS=[{"username":"talha","password":"pick-something-strong"}]
ADMIN_PASSWORD=
